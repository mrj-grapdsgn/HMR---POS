rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Shared Security Primitives ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(ownerId) {
      return isSignedIn() && ownerId == request.auth.uid;
    }

    // ---------- Validation Blueprints ----------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'displayName', 'storeName', 'role', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'displayName', 'storeName', 'role', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 100
        && data.role is string && data.role == 'admin'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffAccount(data) {
      return data.keys().hasAll([
          'ownerId', 'displayName', 'username', 'role', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'displayName', 'username', 'role', 'active', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 40 && data.username.matches('^[a-zA-Z0-9._\\-]+$')
        && data.role is string && data.role in ['admin', 'kasir']
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBranch(data) {
      return data.keys().hasAll([
          'ownerId', 'code', 'name', 'address', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'code', 'name', 'address', 'active', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 24 && data.code.matches('^[A-Z0-9_\\-]+$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.address is string && data.address.size() <= 160
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'ownerId', 'sku', 'barcode', 'name', 'price', 'image', 'category', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'sku', 'barcode', 'name', 'price', 'image', 'category', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 32 && data.sku.matches('^[a-zA-Z0-9_\\-]+$')
        && data.barcode is string && data.barcode.size() >= 1 && data.barcode.size() <= 64 && data.barcode.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.price is number && data.price >= 0 && data.price <= 1000000000
        && data.image is string && data.image.size() <= 300
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBranchStock(data) {
      return data.keys().hasAll([
          'ownerId', 'branchId', 'productId', 'initialStock', 'currentStock', 'minThreshold', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'branchId', 'productId', 'initialStock', 'currentStock', 'minThreshold', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.branchId)
        && isValidId(data.productId)
        && data.initialStock is number && data.initialStock >= 0 && data.initialStock <= 1000000
        && data.currentStock is number && data.currentStock >= 0 && data.currentStock <= 1000000
        && data.minThreshold is number && data.minThreshold >= 0 && data.minThreshold <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStockLog(data) {
      return data.keys().hasAll([
          'ownerId', 'branchId', 'branchName', 'productId', 'productSku', 'productName',
          'type', 'qtyDelta', 'stockBefore', 'stockAfter', 'note', 'actorName', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'branchId', 'branchName', 'productId', 'productSku', 'productName',
          'type', 'qtyDelta', 'stockBefore', 'stockAfter', 'note', 'actorName', 'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.branchId)
        && data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80
        && isValidId(data.productId)
        && data.productSku is string && data.productSku.size() >= 1 && data.productSku.size() <= 32
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 100
        && data.type is string && data.type in ['initial', 'restock', 'adjustment', 'sale', 'import']
        && data.qtyDelta is number && data.qtyDelta >= -1000000 && data.qtyDelta <= 1000000
        && data.stockBefore is number && data.stockBefore >= 0 && data.stockBefore <= 1000000
        && data.stockAfter is number && data.stockAfter >= 0 && data.stockAfter <= 1000000
        && data.note is string && data.note.size() <= 160
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidVoucher(data) {
      return data.keys().hasAll([
          'ownerId', 'code', 'label', 'type', 'value', 'minSubtotal', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'code', 'label', 'type', 'value', 'minSubtotal', 'active', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 32 && data.code.matches('^[A-Z0-9_\\-]+$')
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 40
        && data.type is string && data.type in ['percent', 'fixed']
        && data.value is number && data.value >= 0
        && ((data.type == 'percent' && data.value <= 100) || (data.type == 'fixed' && data.value <= 1000000000))
        && data.minSubtotal is number && data.minSubtotal >= 0 && data.minSubtotal <= 1000000000
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'ownerId', 'branchId', 'branchName', 'invoiceNo', 'cashierName', 'saleYear', 'saleMonth', 'source',
          'itemCount', 'totalQty', 'subtotal', 'discountMode',
          'discountAmount', 'adjustmentLabel', 'grandTotal', 'paymentMethod',
          'amountPaid', 'change', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'branchId', 'branchName', 'invoiceNo', 'cashierName', 'saleYear', 'saleMonth', 'source',
          'itemCount', 'totalQty', 'subtotal', 'discountMode',
          'discountAmount', 'adjustmentLabel', 'grandTotal', 'paymentMethod',
          'amountPaid', 'change', 'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.branchId)
        && data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80
        && data.invoiceNo is string && data.invoiceNo.size() >= 3 && data.invoiceNo.size() <= 32 && data.invoiceNo.matches('^[a-zA-Z0-9_\\-]+$')
        && data.cashierName is string && data.cashierName.size() >= 1 && data.cashierName.size() <= 80
        && data.saleYear is number && data.saleYear >= 2000 && data.saleYear <= 2100
        && data.saleMonth is number && data.saleMonth >= 1 && data.saleMonth <= 12
        && data.source is string && data.source in ['pos', 'import']
        && data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 500
        && data.totalQty is number && data.totalQty >= 1 && data.totalQty <= 10000
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 1000000000
        && data.discountMode is string && data.discountMode in ['none', 'fixed', 'percent', 'exact', 'voucher']
        && data.discountAmount is number && data.discountAmount >= -1000000000 && data.discountAmount <= 1000000000
        && data.adjustmentLabel is string && data.adjustmentLabel.size() <= 100
        && data.grandTotal is number && data.grandTotal >= 0 && data.grandTotal <= 1000000000
        && data.paymentMethod is string && data.paymentMethod in ['cash', 'qris', 'transfer']
        && data.amountPaid is number && data.amountPaid >= 0 && data.amountPaid <= 1000000000
        && data.change is number && data.change >= 0 && data.change <= 1000000000
        && data.createdAt is timestamp;
    }

    function isValidTransactionItem(data, transactionId) {
      return data.keys().hasAll([
          'ownerId', 'transactionId', 'productId', 'name', 'unitPrice', 'qty', 'lineTotal', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'transactionId', 'productId', 'name', 'unitPrice', 'qty', 'lineTotal', 'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.transactionId)
        && data.transactionId == transactionId
        && isValidId(data.productId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 1000000000
        && data.qty is number && data.qty >= 1 && data.qty <= 10000
        && data.lineTotal is number && data.lineTotal >= 0 && data.lineTotal <= 1000000000
        && data.createdAt is timestamp;
    }

    function isValidSalesLine(data) {
      return data.keys().hasAll([
          'ownerId', 'transactionId', 'branchId', 'branchName', 'productId', 'productSku', 'productName',
          'category', 'qty', 'unitPrice', 'lineTotal', 'saleYear', 'saleMonth', 'source', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'transactionId', 'branchId', 'branchName', 'productId', 'productSku', 'productName',
          'category', 'qty', 'unitPrice', 'lineTotal', 'saleYear', 'saleMonth', 'source', 'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.transactionId)
        && isValidId(data.branchId)
        && data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80
        && isValidId(data.productId)
        && data.productSku is string && data.productSku.size() >= 1 && data.productSku.size() <= 32
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 100
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 50
        && data.qty is number && data.qty >= 1 && data.qty <= 10000
        && data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 1000000000
        && data.lineTotal is number && data.lineTotal >= 0 && data.lineTotal <= 1000000000
        && data.saleYear is number && data.saleYear >= 2000 && data.saleYear <= 2100
        && data.saleMonth is number && data.saleMonth >= 1 && data.saleMonth <= 12
        && data.source is string && data.source in ['pos', 'import']
        && data.createdAt is timestamp;
    }

    // ---------- User Profiles Collection ----------
    match /userProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming(), userId)
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'storeName', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // ---------- Staff Accounts Collection ----------
    match /staffAccounts/{staffId} {
      allow get: if isSignedIn() && isValidId(staffId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(staffId)
        && isValidStaffAccount(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(staffId)
        && isValidStaffAccount(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'username', 'role', 'active', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(staffId) && isOwner(existing().ownerId);
    }

    // ---------- Branches Collection ----------
    match /branches/{branchId} {
      allow get: if isSignedIn() && isValidId(branchId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(branchId)
        && isValidBranch(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(branchId)
        && isValidBranch(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'code', 'name', 'address', 'active', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(branchId) && isOwner(existing().ownerId);
    }

    // ---------- Products Collection ----------
    match /products/{productId} {
      allow get: if isSignedIn() && isValidId(productId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(productId)
        && isValidProduct(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'sku', 'barcode', 'name', 'price', 'image', 'category', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(productId) && isOwner(existing().ownerId);
    }

    // ---------- Branch Stocks Collection ----------
    match /branchStocks/{stockId} {
      allow get: if isSignedIn() && isValidId(stockId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(stockId)
        && isValidBranchStock(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/branches/$(incoming().branchId))
        && getAfter(/databases/$(database)/documents/branches/$(incoming().branchId)).data.ownerId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/products/$(incoming().productId))
        && getAfter(/databases/$(database)/documents/products/$(incoming().productId)).data.ownerId == request.auth.uid;

      allow update: if isSignedIn()
        && isValidId(stockId)
        && isValidBranchStock(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().branchId == existing().branchId
        && incoming().productId == existing().productId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: POS sale deduction
          (incoming().currentStock < existing().currentStock
            && incoming().initialStock == existing().initialStock
            && incoming().diff(existing()).affectedKeys().hasOnly(['currentStock', 'updatedAt']))
          ||
          // Action 2: Admin restock / opname / threshold update
          incoming().diff(existing()).affectedKeys().hasOnly([
            'initialStock', 'currentStock', 'minThreshold', 'updatedAt'
          ])
        );

      allow delete: if isSignedIn() && isValidId(stockId) && isOwner(existing().ownerId);
    }

    // ---------- Stock Mutation Logs (Immutable Ledger) ----------
    match /stockLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidStockLog(incoming())
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // ---------- Vouchers Collection ----------
    match /vouchers/{voucherId} {
      allow get: if isSignedIn() && isValidId(voucherId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(voucherId)
        && isValidVoucher(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(voucherId)
        && isValidVoucher(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'code', 'label', 'type', 'value', 'minSubtotal', 'active', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(voucherId) && isOwner(existing().ownerId);
    }

    // ---------- Transactions Collection (Immutable Ledger) ----------
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().createdAt == request.time;

      allow update, delete: if false;

      // ---------- Transaction Line Items Subcollection ----------
      match /items/{itemId} {
        allow get: if isSignedIn()
          && isValidId(transactionId)
          && isValidId(itemId)
          && isOwner(existing().ownerId)
          && get(/databases/$(database)/documents/transactions/$(transactionId)).data.ownerId == request.auth.uid;

        allow list: if isSignedIn()
          && isValidId(transactionId)
          && existing().ownerId == request.auth.uid
          && existing().transactionId == transactionId;

        allow create: if isSignedIn()
          && isValidId(transactionId)
          && isValidId(itemId)
          && isValidTransactionItem(incoming(), transactionId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/transactions/$(transactionId))
          && getAfter(/databases/$(database)/documents/transactions/$(transactionId)).data.ownerId == request.auth.uid;

        allow update, delete: if false;
      }
    }

    // ---------- Sales Lines Analytics Collection (Immutable Ledger) ----------
    match /salesLines/{lineId} {
      allow get: if isSignedIn() && isValidId(lineId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(lineId)
        && isValidSalesLine(incoming())
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/transactions/$(incoming().transactionId))
        && getAfter(/databases/$(database)/documents/transactions/$(incoming().transactionId)).data.ownerId == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
